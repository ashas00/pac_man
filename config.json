{
  # Pac-Man configuration. Comments: "#", "//" and "/* */".
  # Missing or invalid keys fall back to their defaults (see README).

  "highscore_filename": "highscores.json",
  "spritesheet_path": "assets/spritesheet.png",

  // Player and scoring
  "lives": 3,
  "points_per_pacgum": 10,
  "points_per_super_pacgum": 50,
  "points_per_ghost": 200,        /* x1, x2, x4, x8 for ghosts eaten in a row */

  // Speeds in cells per second, timers in seconds
  "player_speed": 5.0,
  "ghost_speed": 3.5,
  "frightened_duration": 7.0,
  "ghost_respawn_delay": 5.0,

  // Levels: level 1 uses "seed", the following ones are random
  "level_count": 10,               # more if "levels" lists more entries
  "pacgum": 0,                      # pacgums per level; 0 = use "pacgum_percent"
  //"pacgum_percent": 60,             # share of the corridor cells with a pacgum (1-100)
  "level_max_time": 90,
  "seed": 42,
  "width": 15,
  "height": 10,
  "cell_size": 48,

  # Optional per-level overrides (width, height, level_max_time, seed)
  "levels": [
    {},
    { "width": 16, "height": 10},
    { "width": 16, "height": 10},
    { "width": 16, "height": 10},
    { "width": 16, "height": 10},
    { "width": 16, "height": 10},
    { "width": 20, "height": 14, "level_max_time": 120 }
  ]
}
